      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(pg_database_size_bytes{namespace=\"$namespace\", datname=\"hearts\"})",
          "legendFormat": "size",
          "editorMode": "code"
        }
