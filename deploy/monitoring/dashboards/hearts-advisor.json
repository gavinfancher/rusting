{
  "uid": "hearts-advisor",
  "title": "Hearts Advisor",
  "tags": [
    "hearts"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "current": {
          "text": "hearts",
          "value": "hearts"
        },
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Advise latency p50 / p95 / p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(hearts_advise_duration_seconds_bucket{namespace=\"$namespace\"}[1m])))",
          "legendFormat": "p50",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hearts_advise_duration_seconds_bucket{namespace=\"$namespace\"}[1m])))",
          "legendFormat": "p95",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hearts_advise_duration_seconds_bucket{namespace=\"$namespace\"}[1m])))",
          "legendFormat": "p99",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Per-shard latency p50 / p95 / p99",
