          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Partial answer rate",
      "description": "Share of advise calls that returned fewer samples than requested.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(hearts_advise_partial_total{namespace=\"$namespace\"}[5m])) / sum(rate(hearts_advise_duration_seconds_count{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "partial fraction",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
